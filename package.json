{
  "name": "kipster-software-factory",
  "version": "0.4.0",
  "description": "Turns tickets into verified pull requests through workflows of agent, human and system steps.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.10.0 <27"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "start": "node src/cli.ts serve",
    "kf": "node src/cli.ts",
    "seed:demo": "node scripts/seed-demo.ts",
    "build": "vite build",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node scripts/with-test-database.ts node --test --test-concurrency=4 \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@hono/node-server": "2.1.3",
    "@napi-rs/keyring": "2.1.0",
    "@typesafe-ai/sdk": "0.6.0",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tanstack/react-query": "5.104.1",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
